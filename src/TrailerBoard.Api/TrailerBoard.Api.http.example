@host = http://localhost:5062
@token = {{token}}

### Register
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "demo@tb.com",
  "password": "secret1",
  "confirmPassword": "secret1",
  "firstName": "Demo",
  "lastName": "User"
}

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@tb.com",
  "password": "secret1"
}

### Current User (me)
GET {{host}}/api/auth/current
Authorization: Bearer {{token}}

### Add Favorite (Inception)
POST {{host}}/api/favorite
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "publicId": "MOV-INCEPTION"
}

### List Favorites
GET {{host}}/api/favorite
Authorization: Bearer {{token}}

### Remove Favorite (Inception)
DELETE {{host}}/api/favorite/MOV-INCEPTION
Authorization: Bearer {{token}}
